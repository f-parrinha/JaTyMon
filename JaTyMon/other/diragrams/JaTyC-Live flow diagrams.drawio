        </mxCell>
        <mxCell id="OJzDrqCLXjhtIuUQVfKB-42" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;justify&quot;&gt;Generates monitors that extends original protocol, using Java&#39;s polymorphism. Does not require custom channels. To use the monitors, programmers register the Monitor protocol instead of the original one.&lt;/div&gt;" vertex="1">
