        <mxCell id="OJzDrqCLXjhtIuUQVfKB-17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#008a00;fontColor=#ffffff;strokeColor=#005700;" value="MonChannel" vertex="1">
