        </mxCell>
        <mxCell id="OJzDrqCLXjhtIuUQVfKB-27" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Architecture 1: Monitors are independent protocols&lt;/h1&gt;" vertex="1">
          <mxGeometry height="40" width="905" x="-520" y="-80" as="geometry" />
        </mxCell>
        <mxCell id="OJzDrqCLXjhtIuUQVfKB-28" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Architecture 2: Monitors extend original protocols&lt;/h1&gt;" vertex="1">
          <mxGeometry height="40" width="905" x="-520" y="320" as="geometry" />
        </mxCell>
        <mxCell id="OJzDrqCLXjhtIuUQVfKB-30" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;justify&quot;&gt;&lt;b&gt;Problem with &lt;i&gt;ext&lt;/i&gt; fields&lt;/b&gt;: protocols require a getter for all ext fields. Otherwise, the monitorData cannot know the value of an ext field at runtime.&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="315" x="195" as="geometry" />
        </mxCell>
