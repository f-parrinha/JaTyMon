        <mxCell id="OJzDrqCLXjhtIuUQVfKB-18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;justify&quot;&gt;&lt;b&gt;MonChannel&lt;/b&gt;: custom channel built on top of a TCP channel that intercepts the messages and sends first to the monitorData, who may reply back to the protocol if the message is valid.&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="315" x="-515" as="geometry" />
        </mxCell>
        <mxCell id="OJzDrqCLXjhtIuUQVfKB-20" parent="1" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;" value="Network" vertex="1">
          <mxGeometry height="170" width="240" x="-117.5" y="90" as="geometry" />
        </mxCell>
        <mxCell id="OJzDrqCLXjhtIuUQVfKB-23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;justify&quot;&gt;&lt;b&gt;Problem with returned values&lt;/b&gt;: exchanged messages must include the action&#39;s return value. The monitorData monitors functions called by the protocol. If the message is intercepted before the method call, it cannot know the return type.&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="315" x="-157.5" as="geometry" />
        </mxCell>
        <mxCell id="OJzDrqCLXjhtIuUQVfKB-24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" value="Protocol" vertex="1">
