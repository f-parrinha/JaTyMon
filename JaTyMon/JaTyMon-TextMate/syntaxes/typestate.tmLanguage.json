{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Typestate",
  "scopeName": "source.typestate",
  "patterns": [
    { "include": "#comments" },
    { "include": "#package-import" },
    { "include": "#typestate-declaration" },
    { "include": "#internal-state-keywords" },
    { "include": "#state-name" },
    { "include": "#action-properties" },
    { "include": "#java-primitives" },
    { "include": "#action" },
    { "include": "#operators" },
    { "include": "#number" },
    { "include": "#wildcard" },
    { "include": "#end-keyword" },
    { "include": "#identifier" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.block",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line",
          "match": "//.*$"
        }
      ]
    },

    "package-import": {
      "patterns": [
        {
          "match": "\\b(package)\\s+([$_a-zA-Z][$_a-zA-Z0-9]*(?:\\.[$_a-zA-Z0-9]+)*)\\s*;",
          "captures": {
            "1": { "name": "keyword" },
            "2": { "name": "entity.name.namespace" }
          }
        },
        {
          "match": "\\b(import)\\s+(static\\s+)?([$_a-zA-Z][$_a-zA-Z0-9]*(?:\\.[$_a-zA-Z0-9]+)*(?:\\.\\*)?)\\s*;",
          "captures": {
            "1": { "name": "keyword" },
            "2": { "name": "keyword" },
            "3": { "name": "entity.name.namespace" }
          }
        }
      ]
    },

    "typestate-declaration": {
      "match": "\\b(typestate)\\s+([A-Z][$_a-zA-Z0-9]*)(?:\\s+(keyed)\\s+([$_a-zA-Z][$_a-zA-Z0-9]*))?\\b",
      "captures": {
        "1": { "name": "keyword" },
        "2": { "name": "entity.name.type" },
        "3": { "name": "keyword" },
        "4": { "name": "variable" }
      }
    },

    "internal-state-keywords": {
      "patterns": [
        {
          "match": "\\b(Ext)\\s+([$_a-zA-Z][$_a-zA-Z0-9]*)\\b",
          "captures": {
            "1": { "name": "storage.type" },
            "2": { "name": "variable" }
          }
        },
        {
          "match": "\\b(Val)\\s+([$_a-zA-Z][$_a-zA-Z0-9]*)\\b",
          "captures": {
            "1": { "name": "storage.type" },
            "2": { "name": "variable" }
          }
        },
        {
          "match": "\\b(Pred)\\s+([$_a-zA-Z][$_a-zA-Z0-9]*)\\b",
          "captures": {
            "1": { "name": "storage.type" },
            "2": { "name": "entity.name.function" }
          }
        },
        {
          "match": "\\b(Assign)\\s+([$_a-zA-Z][$_a-zA-Z0-9]*)\\b",
          "captures": {
            "1": { "name": "storage.type" },
            "2": { "name": "entity.name.function" }
          }
        }
      ]
    },

    "state-name": {
      "name": "entity.name.class",
      "match": "\\b[A-Z][a-zA-Z0-9]*\\b"
    },

    "java-primitives": {
      "name": "storage.type",
      "match": "\\b(void|int|short|long|byte|char|float|double|boolean)\\b"
    },

    "action": {
      "match": "\\b([$_a-zA-Z][$_a-zA-Z0-9]*)\\s+([$_a-zA-Z][$_a-zA-Z0-9]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "storage.type" },
        "2": { "name": "entity.name.function" }
      }
    },

    "action-properties": {
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation" } },
      "endCaptures":   { "0": { "name": "punctuation" } },
      "patterns": [
        { "include": "#wildcard" },
        {
          "name": "entity.name.function",
          "match": "[$_a-zA-Z][$_a-zA-Z0-9]*"
        },
        {
          "name": "punctuation.separator",
          "match": "[;,]"
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator", "match": ":=" },
        { "name": "keyword.operator", "match": "=" },
        { "name": "keyword.operator", "match": "&&|\\|\\|" },
        { "name": "keyword.operator", "match": "[+\\-*/]" },
        { "name": "punctuation", "match": "[{}()\\[\\]<>,;:.]" }
      ]
    },

    "number": {
      "name": "constant.numeric",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
    },

    "wildcard": {
      "name": "constant.language",
      "match": "\\b_\\b"
    },

    "end-keyword": {
      "name": "keyword",
      "match": "\\bend\\b"
    },

    "identifier": {
      "name": "variable",
      "match": "[$_a-zA-Z][$_a-zA-Z0-9]*"
    }
  }
}