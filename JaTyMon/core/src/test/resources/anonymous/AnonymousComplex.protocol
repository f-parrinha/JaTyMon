typestate AnonymousComplex {
    State0 = {
        void m1(): {
           void m1(): State1,
           void m2(): State2
       },
        void m2(): State2
    }

    State1 = {
        void m1(): State0,
        void m2(): {
            void m1(): State1,
            void m2(): State2
        }
    }

    State2 = {
        void m2(): end
    }
}