import jatymon.babelprojects.abp.timers.SendBitTimer;
import jatymon.babelprojects.abp.notifications.messages.ReceivedAckMessageNotification;
import jatymon.babelprojects.abp.notifications.messages.ReceivedBitMessageNotification;
import jatymon.babelprojects.abp.notifications.connection.ConnectionDownNotification;
import jatymon.babelprojects.abp.notifications.connection.ConnectionUpNotification;
import pt.unl.fct.di.novasys.network.data.Host;


typestate ABP {
    Ext peersSize;
    Val conns = 0;

    Assign connUp: conns := conns + 1;
    Assign connDown: conns := conns - 1;

    Pred hasAllConns: conns = peersSize - 1;

    Start = {
        void uponConnectionUp(ConnectionUpNotification, short)[1; connUp; hasAllConns]: Main,
        void uponConnectionDown(ConnectionDownNotification, short)[0; connDown; _]: Start
    }

    Main = {
        void uponConnectionDown(ConnectionDownNotification, short)[0; connDown; _]: Start,
        void receiveBitMessage(ReceivedBitMessageNotification, short)[0.5]: Main,
        void receiveAckMessage(ReceivedAckMessageNotification, short)[0.5]: Main
    } + (
        void sendAckMessage(Host, byte): Main,
        void uponSendBitTimer(SendBitTimer, long): Main
    )
}