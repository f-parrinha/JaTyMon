/*
 * Rule5Protocol > Well-Scoped Expressions
 *  This typestate breaks Rule 5 (Well-Scoped Expressions) from our work for ECOOP 2027
 *  Every assignment and predicate must us a counter (variable or read-only) that is already defined.
 *      This protocol breaks that rule so we can see the corresponding errors reported by JaTyMon
 *
 * Number of errors to display: 3
 * Author: Francisco Parrinha
 */

 typestate Rule5Protocol {
    Val v = 0;
    Ext c;

    // Error > Unknown field name 'v1'
    Assign a: v1 := 1;

    // Error > Unknown field name 'v2'
    // Error > Unknown field name 'c1'
    Pred p: v2 = c1;

    State0 = {
        void action(): State0
    }
 }