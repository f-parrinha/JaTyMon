/*
 * Rule6Protocol > Read-only constants
 *  This typestate breaks Rule 6 (Read-only Constants) from our work for ECOOP 2027
 *  Read-only variable counters (Ext fields) cannot be mutated by the typestate. We break that rule
 *      in this protocol so we can see the report given by JaTyMon.
 *
 * Number of errors to display: 1
 * Author: Francisco Parrinha
 */

 typestate Rule6Protocol {
    Ext c;

    // Error > Cannot change the value of an Ext fields. Ext fields are immutable.
    Assign a1: c := c + 1;

    State0 = {
        void action(): State0
    }
 }