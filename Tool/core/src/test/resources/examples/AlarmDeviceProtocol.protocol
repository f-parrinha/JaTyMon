typestate AlarmDeviceProtocol {

  DISC = {
    void connect(): CONN
  }

  CONN = {
    void notify(double): NOTIFIED,
    void setThreshold(double): CONN,
    void disconnect(): DISC
  }

  NOTIFIED = {
    boolean thresholdCheck(): <true: ALERT, false: CONN>
  }

  ALERT = {
    void alert(): CONN
  }

}
